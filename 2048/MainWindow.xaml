<Window x:Class="_2048.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2048"
        mc:Ignorable="d"
        Title="2048" Height="521" Width="407" KeyDown="Window_KeyDown"
        Background="#FAF8EF"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="RoundedBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#4A90E2"/>
            <Setter Property="BorderThickness" Value="6"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Background" Value="#FAF8EF"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
        <Style x:Key="BtnStyle" TargetType="Button">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontFamily" Value="Arial Black"/>
            <Setter Property="Background" Value="#FAF8EF"/>
            <Setter Property="Foreground" Value="#FF7F7F6F"/>
            <Setter Property="BorderBrush" Value="Red"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="204*"/>
            <ColumnDefinition Width="203*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- statistics -->
        <Grid Grid.Row="0" Margin="10,10,10,10" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="ScoreFrame1" Style="{StaticResource RoundedBorderStyle}" Grid.Column="0">
                <StackPanel x:Name="Statistics1">
                    <Label Content="Current score" FontSize="19" 
                           HorizontalAlignment="Center" VerticalAlignment="Top" 
                           FontFamily="SimSun-ExtG" FontWeight="Bold" />
                    <TextBlock x:Name="CurrentScore" HorizontalAlignment="Center" 
                               Width="100" Height="26" Text="{Binding Score}" Foreground="#FF3E47D0"
                               FontFamily="Yu Gothic Medium" FontSize="22" TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border x:Name="ScoreFrame2" Style="{StaticResource RoundedBorderStyle}" Grid.Column="1">
                <StackPanel x:Name="Statistics2">
                    <Label Content="Best score" FontSize="19" 
                           HorizontalAlignment="Center" VerticalAlignment="Top" 
                           FontFamily="SimSun-ExtG" FontWeight="Bold"/>
                    <TextBlock x:Name="BestScore" HorizontalAlignment="Center" Text="{Binding HighScore}"
                             Width="100" Height="26" Foreground="#FFBB4B4B"
                            FontFamily="Yu Gothic Medium" FontSize="22" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
        <Border x:Name="MainFrame" Style="{StaticResource RoundedBorderStyle}" Grid.Row="1" BorderBrush="Red" Grid.ColumnSpan="2" Margin="3,3,3,3">
            <Grid x:Name="FieldGrid" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Row="0" Grid.Column="0" Content="{Binding GameGrid[0]}" Style="{StaticResource BtnStyle}"/>
                <Button Grid.Row="0" Grid.Column="1" Content="{Binding GameGrid[1]}" Style="{StaticResource BtnStyle}"/>
                <Button Grid.Row="0" Grid.Column="2" Content="{Binding GameGrid[2]}" Style="{StaticResource BtnStyle}"/>
                <Button Grid.Row="0" Grid.Column="3" Content="{Binding GameGrid[3]}" Style="{StaticResource BtnStyle}"/>

                <Button Grid.Row="1" Grid.Column="0" Content="{Binding GameGrid[4]}" Style="{StaticResource BtnStyle}"/>
                <Button Grid.Row="1" Grid.Column="1" Content="{Binding GameGrid[5]}" Style="{StaticResource BtnStyle}"/>
                <Button Grid.Row="1" Grid.Column="2" Content="{Binding GameGrid[6]}" Style="{StaticResource BtnStyle}"/>
                <Button Grid.Row="1" Grid.Column="3" Content="{Binding GameGrid[7]}" Style="{StaticResource BtnStyle}"/>

                <Button Grid.Row="2" Grid.Column="0" Content="{Binding GameGrid[8]}" Style="{StaticResource BtnStyle}"/>
                <Button Grid.Row="2" Grid.Column="1" Content="{Binding GameGrid[9]}" Style="{StaticResource BtnStyle}"/>
                <Button Grid.Row="2" Grid.Column="2" Content="{Binding GameGrid[10]}" Style="{StaticResource BtnStyle}"/>
                <Button Grid.Row="2" Grid.Column="3" Content="{Binding GameGrid[11]}" Style="{StaticResource BtnStyle}"/>

                <Button Grid.Row="3" Grid.Column="0" Content="{Binding GameGrid[12]}" Style="{StaticResource BtnStyle}"/>
                <Button Grid.Row="3" Grid.Column="1" Content="{Binding GameGrid[13]}" Style="{StaticResource BtnStyle}"/>
                <Button Grid.Row="3" Grid.Column="2" Content="{Binding GameGrid[14]}" Style="{StaticResource BtnStyle}"/>
                <Button Grid.Row="3" Grid.Column="3" Content="{Binding GameGrid[15]}" Style="{StaticResource BtnStyle}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
